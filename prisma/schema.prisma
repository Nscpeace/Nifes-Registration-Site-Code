generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
}

enum Level {
  L100
  L200
  L300
  L400
  L500
  L600
  POSTGRADUATE
}

enum HeardAbout {
  Friend
  WhatsApp
  Instagram
  Flier
  Other
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  USHER
}

enum AdminStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum FollowUpStatus {
  NOT_CONTACTED
  CONTACTED
  VISITED
  INTEGRATED
}

enum CheckInMethod {
  SELF
  QR
  USHER
  OFFLINE
}

model Member {
  id               String       @id @default(cuid())
  memberId         String       @unique @map("member_id")
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  gender           Gender
  email            String?      @unique
  placeOfResidence String?      @map("place_of_residence")
  heardAbout       HeardAbout?  @map("heard_about")
  heardAboutOther  String?      @map("heard_about_other")
  firstTimer       Boolean      @map("first_timer")
  phone            String       @unique
  level            Level?
  consentGivenAt   DateTime?    @map("consent_given_at")
  guest            Boolean      @default(false)
  createdAt        DateTime     @default(now()) @map("created_at")
  attendances      Attendance[]
  followUps        FollowUp[]

  @@index([createdAt])
  @@index([lastName, firstName])
  @@map("members")
}

model AdminUser {
  id          String      @id @default(cuid())
  email       String      @unique
  role        AdminRole   @default(USHER)
  status      AdminStatus @default(INVITED)
  invitedBy   String?     @map("invited_by")
  inviter     AdminUser?  @relation("AdminInvites", fields: [invitedBy], references: [id], onDelete: SetNull)
  invitees    AdminUser[] @relation("AdminInvites")
  createdAt   DateTime    @default(now()) @map("created_at")
  lastLoginAt DateTime?   @map("last_login_at")
  auditLogs   AuditLog[]

  @@map("admin_users")
}

model RecurringEvent {
  id                   String    @id @default(cuid())
  name                 String
  recurrence           String // WEEKLY or LAST_SATURDAY; kept flexible for future patterns
  weekday              Int? // JS weekday: Sunday=0
  startTime            String // local 24h HH:mm; editable in admin
  timeTBA              Boolean   @default(false) @map("time_tba")
  venue                String    @default("FAGCOOP Multipurpose Hall")
  active               Boolean   @default(true)
  checkInOpensMinutes  Int       @default(60)
  checkInClosesMinutes Int       @default(120)
  sessions             Session[]

  @@map("recurring_events")
}

model Session {
  id          String          @id @default(cuid())
  eventId     String?         @map("event_id")
  event       RecurringEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name        String
  startsAt    DateTime        @map("starts_at")
  endsAt      DateTime?       @map("ends_at")
  venue       String          @default("FAGCOOP Multipurpose Hall")
  active      Boolean         @default(true)
  attendances Attendance[]

  @@unique([eventId, startsAt])
  @@index([startsAt, active])
  @@map("sessions")
}

model Attendance {
  id          String        @id @default(cuid())
  memberId    String        @map("member_id")
  sessionId   String        @map("session_id")
  checkedInAt DateTime      @default(now()) @map("checked_in_at")
  method      CheckInMethod
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([memberId, sessionId])
  @@index([sessionId, checkedInAt])
  @@map("attendance")
}

model FollowUp {
  id        String         @id @default(cuid())
  memberId  String         @map("member_id")
  status    FollowUpStatus @default(NOT_CONTACTED)
  notes     String?
  updatedAt DateTime       @updatedAt @map("updated_at")
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId])
  @@map("follow_ups")
}

model AuditLog {
  id        String     @id @default(cuid())
  adminId   String?    @map("admin_id")
  action    String
  details   Json?
  createdAt DateTime   @default(now()) @map("created_at")
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimit {
  key     String   @id
  hits    Int      @default(1)
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limits")
}

model MemberSequence {
  year      Int @id
  nextValue Int @map("next_value")

  @@map("member_sequences")
}
